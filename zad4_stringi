namespace strutil{

std::string convertCase(const std::string &s, bool upperCase){
    std::string nowy;
    for (size_t i = 0; i < s.length(); i++)
    {
        if(upperCase==true){
            nowy += toupper(s[i]);
        }
        else
        {
            nowy += tolower(s[i]);
        }
    }
    return nowy;
}

bool isPalindrome(const std::string &s){
    
    for(size_t i=0; i<s.length()/2; i++ ){
        if(s[i] != s[s.length()-1-i])
        return false;
    }
    return true;
}

std::string rand(size_t n){
    std::string slowo = "";
    std::string alfabet = "abcdefghijklmnopqrstuvwxyz";
    for (size_t i =0; i<n; i++){
         slowo += alfabet[::rand() % alfabet.length()];
    }
    return slowo;
}


size_t longestWordLength(const std::string &s){
    size_t maxdlugosc = 0;
    size_t aktualnadlugosc = 0;
    for (size_t i = 0; i < s.length(); i++){
        char c = s[i];
        if (c == ' '){
            if (aktualnadlugosc > maxdlugosc){
                maxdlugosc = aktualnadlugosc;    
            }
            aktualnadlugosc = 0;
        }else{
                aktualnadlugosc++;
            }
        }
        if (aktualnadlugosc > maxdlugosc){
            maxdlugosc = aktualnadlugosc;
    }
    return maxdlugosc;
}


void rot13(std::string &s){
    
    for (size_t i = 0; i < s.length(); i++){
        if (s[i] >= 97 && s[i] <= 122) {
            s[i] = 97 + (s[i] - 97 + 13) % 26;
        } else if (s[i] >= 65 && s[i] <= 90){
            s[i] = 65 + (s[i] - 65 + 13) % 26;
        }
    }
}

size_t countOccurence(const std::string &s1, const std::string &s2){
    size_t count = 0;
    for (size_t i = 0; i <= s2.length() - s1.length();){
        if(s2.substr(i, s1.length()) == s1){
            count++;
            i+= s1.length();
        } else {
            i++;
        }
    }
    return count;
}


